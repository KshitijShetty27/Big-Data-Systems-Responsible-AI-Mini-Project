# ============================================================================
# Real-Time Credit Card Fraud Detection Pipeline — Example Environment File
# Copy this file to `.env` to customize ports, paths, thresholds, or resources.
# No secrets or external cloud credentials are required.
# ============================================================================

# --- Dataset and Model Paths (relative to project root) ---
RAW_CSV_PATH=data/raw/creditcard.csv
HELDOUT_CSV_PATH=data/processed/heldout_transactions.csv
MODEL_JOBLIB_PATH=models/fraud_model.joblib
MODEL_ARTIFACT_PATH=models/fraud_model_artifact.json
RESULTS_DIR=results

# --- Model Training & Scoring Configuration ---
RANDOM_SEED=42
TEST_SIZE=0.20
FRAUD_THRESHOLD=0.50

# --- Apache Kafka Configuration ---
# Host scripts connect via localhost:29092; containers connect via kafka:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_INTERNAL_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_HOST_PORT=29092
KAFKA_TOPIC=transactions.raw.v1
KAFKA_DLQ_TOPIC=transactions.dlq.v1
KAFKA_CONSUMER_GROUP=flink-fraud-scorer

# --- Apache Flink Configuration ---
FLINK_WEB_UI_PORT=8081
FLINK_PARALLELISM=2
FLINK_JOBMANAGER_HEAP_SIZE=1024m
FLINK_TASKMANAGER_PROCESS_SIZE=1536m
FLINK_TASK_SLOTS=2
FLINK_CHECKPOINT_INTERVAL_MS=5000

# --- Apache Iceberg REST Catalog & Local MinIO Object Store ---
# Host scripts connect via localhost; containers connect via iceberg-rest / minio
ICEBERG_REST_PORT=8181
ICEBERG_REST_URI=http://localhost:8181
ICEBERG_INTERNAL_REST_URI=http://iceberg-rest:8181
ICEBERG_WAREHOUSE=s3://warehouse/
ICEBERG_NAMESPACE=fraud_detection
ICEBERG_TABLE=scored_transactions

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_INTERNAL_ENDPOINT=http://minio:9000
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password123
AWS_REGION=us-east-1

# --- Load Testing Defaults (CPU-friendly for ~12 GB RAM) ---
LOAD_TEST_RATES=200,500,1000
LOAD_TEST_EVENTS_PER_RUN=3000
LOAD_TEST_SETTLE_TIMEOUT_SEC=60
